[Unit]
Description=Capability-based NVIDIA Xid79 recovery controller
After=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/gpu-recovery watch --config /etc/gpu-recovery/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=360
KillMode=mixed
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
